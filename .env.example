# neonpilot has no runtime secrets (local CLI, no network calls, no telemetry --
# see ASSUMPTIONS.md #11). The variables below are optional overrides for local dev/CI.

# Override where scripts/fetch_llama.sh clones/builds llama.cpp (default: vendor/llama.cpp).
# NEONPILOT_VENDOR=vendor/llama.cpp

# Override the discovered llama-bench binary path (used by tests / prebuilt CI cache).
# NEONPILOT_LLAMA_BIN=vendor/llama.cpp/build/bin/llama-bench

# Set to 1 to enable gated integration tests that invoke the real llama-bench binary
# (tests/test_runner_integration.py). Requires a built binary and the cached tiny model.
# NEONPILOT_INTEGRATION=1
